# =====================================================================
# trading-system environment configuration (EXAMPLE ONLY — do not commit real secrets)
#
# This file contains variables for the trading-system Python package
# (src/trading_system/) and frontend OAuth configuration.
#
# For the FastAPI backend configuration, see backend/.env.example
# =====================================================================

# =====================================================================
# TRADING-SYSTEM PACKAGE CONFIGURATION (src/trading_system/config.py)
# =====================================================================

# ---- Market data provider ----
# Primary target is Indian markets (Upstox); Binance remains the dev/test provider.
MARKET_DATA_PROVIDER=upstox
SYMBOLS=BTCUSDT,ETHUSDT
TIMEFRAME=1d
LOOKBACK_BARS=365
# Provider request timeout (seconds)
PROVIDER_TIMEOUT=20

# ---- Market / target config ----
MARKET=india
DEFAULT_EXCHANGE=NSE
TIMEZONE=Asia/Kolkata
# AI analysis cadence: build a MarketSnapshot every N closed bars (NOT per tick).
ANALYSIS_INTERVAL_BARS=1

# ---- Upstox OAuth (for frontend OAuth flow) ----
# These are used by the frontend OAuth flow, NOT by the backend V3 WebSocket.
# Get Client ID + Secret from console.upstox.com
# UPSTOX_REDIRECT_URI must match what you registered in the Upstox console.
# Production value: https://tradingsystem-zeta.vercel.app/api/upstox/callback
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=
UPSTOX_ACCESS_TOKEN=

# ---- Storage ----
DB_PATH=data/market_data.db
# For Postgres later: DB_PATH=postgresql://user:pass@host:5432/dbname (use secret manager)

# ---- Logging ----
LOG_LEVEL=INFO
LOG_DIR=logs

# ---- AI analyst (defaults to the OFFLINE local rule model) ----
# Provider: "local" (offline, no API key) or "openai-compatible" (needs a key).
AI_PROVIDER=local
AI_MODEL=local-rule
AI_API_BASE=http://localhost:11434/v1
# Name of the ENV VAR holding the model API key (NOT the key itself):
# Only needed when AI_PROVIDER=openai-compatible. Never put the key value here.
AI_API_KEY_ENV=

# ---- Telegram notifications (disabled by default) ----
TELEGRAM_ENABLED=false
# Names of ENV VARS holding credentials (NOT the values):
TELEGRAM_TOKEN_ENV=TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID_ENV=TELEGRAM_CHAT_ID

# ---- Paper trading (disabled by default) ----
PAPER_TRADING_ENABLED=false
PAPER_CAPITAL=100000.0
PAPER_CURRENCY=USDT

# =====================================================================
# BACKEND CONFIGURATION
# For the FastAPI backend environment variables, see backend/.env.example
# The backend uses UPSTOX_CLIENT_ID and UPSTOX_SERVICE_ACCOUNT_TOKEN
# from its own .env file (backend/.env).
# =====================================================================

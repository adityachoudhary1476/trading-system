# =====================================================================
# trading-system environment configuration (EXAMPLE ONLY — do not commit real secrets)
# Copy to `.env` and fill in. ALL secret values are read from the
# environment at runtime; this file contains placeholders only.
# =====================================================================

# ---- Market data provider ----
# Primary target is Indian markets (FYERS); Binance remains the dev/test provider.
MARKET_DATA_PROVIDER=fyers
SYMBOLS=BTCUSDT,ETHUSDT
TIMEFRAME=1d
LOOKBACK_BARS=365
# Provider request timeout (seconds)
PROVIDER_TIMEOUT=20

# ---- FYERS (Indian market) ----
# NEVER put the actual values here. Provide them via the environment only.
# Get App ID + Secret from myapi.fyers.in; access token via OAuth2 flow.
FYERS_CLIENT_ID=
FYERS_ACCESS_TOKEN=

# ---- Storage ----
DB_PATH=data/market_data.db
# For Postgres later: DB_PATH=postgresql://user:pass@host:5432/dbname (use secret manager)

# ---- Logging ----
LOG_LEVEL=INFO
LOG_DIR=logs

# ---- AI analyst (Day 2 component; defaults to the OFFLINE local rule model) ----
# Provider: "local" (offline, no API key) or "openai-compatible" (needs a key).
AI_PROVIDER=local
AI_MODEL=local-rule
AI_API_BASE=http://localhost:11434/v1
# Name of the ENV VAR holding the model API key (NOT the key itself):
# Only needed when AI_PROVIDER=openai-compatible. Never put the key value here.
AI_API_KEY_ENV=

# ---- Telegram notifications (disabled by default) ----
TELEGRAM_ENABLED=false
# Names of ENV VARS holding credentials (NOT the values):
TELEGRAM_TOKEN_ENV=TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID_ENV=TELEGRAM_CHAT_ID

# ---- Paper trading (disabled by default; no execution Day 1) ----
PAPER_TRADING_ENABLED=false
PAPER_CAPITAL=100000.0
PAPER_CURRENCY=USDT

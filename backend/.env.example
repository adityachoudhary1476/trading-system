# Backend Environment Variables
# Copy this to .env in the backend/ directory and fill in real values
# This file is for the Python FastAPI backend only.

# =====================================================================
# SUPABASE CONFIGURATION (Required for database and auth)
# =====================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# =====================================================================
# UPSTOX CONFIGURATION (Required for V3 market data WebSocket)
# =====================================================================
# Upstox Client ID from console.upstox.com (dedicated market data account)
UPSTOX_CLIENT_ID=

# Upstox Access Token for the dedicated market data account
# This is used by the V3 WebSocket for authorization
UPSTOX_SERVICE_ACCOUNT_TOKEN=

# AES-256 key for encrypting stored tokens (must match frontend Vercel functions)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
UPSTOX_TOKEN_ENCRYPTION_KEY=

# =====================================================================
# APPLICATION CONFIGURATION
# =====================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# =====================================================================
# LIVE PIPELINE CONFIGURATION
# =====================================================================
# Enable/disable the live market data pipeline
LIVE_PIPELINE_ENABLED=false

# Comma-separated list of symbols to analyze
SIGNAL_UNIVERSE=NSE:SBIN,NSE:RELIANCE,NSE:TCS,NSE:INFY,NSE:HDFCBANK,NSE:ICICIBANK,NSE:KOTAKBANK,NSE:AXISBANK,NSE:LT,NSE:WIPRO

# =====================================================================
# PAPER TRADING DATABASE (used by PaperTradingControlCenter)
# =====================================================================
# SQLAlchemy database URL for the paper-trading control center.
# Defaults to sqlite:///./data/market_data.db (local file in the working dir).
# In Railway, set this to the production database URL (e.g. postgresql+psycopg2://...).
MARKET_DATA_DB_URL=sqlite:///./data/market_data.db

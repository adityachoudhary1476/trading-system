{
  "version": 2,
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/market/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/upstox/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/paper/[...path].ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/paper/(.*)", "dest": "/api/paper/[...path].ts" },
    { "src": "/api/(.*)", "dest": "/api/$1.ts" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}

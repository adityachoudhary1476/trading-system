{
  "version": 2,
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/market/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/upstox/*.ts",
      "use": "@vercel/node"
    }
}

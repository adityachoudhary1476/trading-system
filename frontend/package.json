{
  "name": "finova-markets",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FINOVA MARKETS — AI Market Intelligence terminal (frontend). Fetches live data from Upstox via Vercel serverless functions.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc --noEmit -p tsconfig.api.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.102.8",
    "lightweight-charts": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.2.4",
    "react-resizable": "^4.0.2",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "20.19.43",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-grid-layout": "^1.3.6",
    "@vercel/node": "^12.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.5.4",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "tar": "^7.5.21",
    "esbuild": "0.28.2",

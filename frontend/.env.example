# =====================================================================
# FINOVA MARKETS frontend — environment configuration (EXAMPLE ONLY)
# Copy to `.env` and fill in. VITE_* variables are embedded into the
# client bundle at build time and are therefore PUBLIC. Never put
# secrets behind a VITE_ prefix.
# =====================================================================

# ---- Supabase (auth + token storage) ----
# Public anon key and project URL — safe to embed in the client bundle.
# Get these from your Supabase project settings > API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ---- Paper trading API (local Python server — LOCAL DEV ONLY) ----
# Leave UNSET in production. The browser then uses same-origin /api/paper/*
# routes, which Vercel routes to the api/paper/[...path].ts serverless function
# that forwards to PYTHON_BACKEND_URL (Railway). Setting this to a remote
# URL in production would make the browser bypass the Vercel proxy.
VITE_PAPER_API_URL=http://127.0.0.1:8765

# ---- Live quote polling (frontend) ----
# Polling interval for GET /api/market/quote, in milliseconds.
# Default: 2000 (0.5 Hz — one request per active symbol every 2 seconds).
# Do NOT confuse this with OHLCV/history polling (handled separately by
# the Dashboard).  Values below ~500 ms risk overlapping requests and
# Upstox rate limits; values above 30000 ms are unlikely to be useful.
VITE_QUOTE_POLL_INTERVAL_MS=2000

# ---- Server-side (Vercel functions ONLY — never prefix with VITE_) ----
# These are read by api/upstox/*.ts. They must NOT be prefixed with VITE_
# because that would embed them in the public browser bundle.
# Set them in Vercel dashboard for production, or in .env for `vercel dev`.
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=https://tradingsystem-zeta.vercel.app/api/upstox/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
UPSTOX_TOKEN_ENCRYPTION_KEY=

{
  "version": 3,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "frontend/api/market/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/api/paper/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/api/upstox/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    }
  ],
  "routes": [
    { "src": "/api/upstox/(.*)", "dest": "/api/index.py" },
    { "src": "/api/(.*)", "dest": "/frontend/api/$1.ts" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
